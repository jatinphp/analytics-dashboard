# Copy to backend/.env for local (non-Docker) runs.

DATABASE_URL=postgresql+asyncpg://analytics:analytics@localhost:5432/analytics

# Leave empty to use in-memory WebSocket broadcast (fine for a single
# backend process). Set to enable Redis pub/sub fan-out across replicas.
REDIS_URL=

FAKE_EVENT_MIN_INTERVAL=0.4
FAKE_EVENT_MAX_INTERVAL=1.5
MATERIALIZED_VIEW_REFRESH_SECONDS=15
